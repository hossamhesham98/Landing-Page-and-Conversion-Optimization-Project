# Set DNS A records for these three names to your Linux server.
STOREFRONT_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
MEDUSA_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Generate DIFFERENT values using: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_HEX_SECRET
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_HEX_SECRET
JWT_SECRET=REPLACE_WITH_UNIQUE_HEX_SECRET
COOKIE_SECRET=REPLACE_WITH_UNIQUE_HEX_SECRET
DOCLOROO_TRACKING_SECRET=REPLACE_WITH_UNIQUE_HEX_SECRET

# Fill after creating the publishable key on the NEW server; never copy local keys.
MEDUSA_PUBLISHABLE_KEY=

# Keep closed until designs, actual inventory, configuration and live QA are approved.
DOCLOROO_CHECKOUT_VERIFIED=false
DOCLOROO_PRODUCTION_LAUNCH_APPROVED=false

# Real transactional SMTP. OTP is unavailable until a working provider is configured.
DOCLOROO_MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
